{
    "name": "homebridge-esphome-ts",
    "displayName": "ESPHome TS",
    "version": "1.5.3",
    "description": "New plugin for integrating for esphome into homebridge",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "rimraf ./dist && tsc",
        "lint": "eslint . --max-warnings=0",
        "typecheck": "tsc --noEmit -p tsconfig.spec.json",
        "format": "prettier -w --ignore-unknown .",
        "format:check": "prettier --check --ignore-unknown .",
        "test": "vitest run",
        "test:watch": "vitest",
        "verify": "npm run lint && npm run typecheck && npm run build && npm run format:check && npm test && node --input-type=module -e \"await import('./dist/index.js')\"",
        "integration:test": "homebridge -U examples -P .",
        "prepublishOnly": "npm run verify"
    },
    "repository": "https://github.com/lucavb/homebridge-esphome-ts",
    "files": [
        "dist",
        "config.schema.json"
    ],
    "keywords": [
        "homebridge",
        "esphome",
        "homebridge-plugin"
    ],
    "author": "Luca Becker <luca.becker@sunbury.xyz> (https://sunbury.xyz/)",
    "license": "GPL-3.0",
    "engines": {
        "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
        "homebridge": "^1.6.0 || ^2.0.0"
    },
    "dependencies": {
        "bonjour-hap": "^3.10.5",
        "esphome-ts": "^5.0.0",
        "rxjs": "^7.8.2"
    },
    "publishConfig": {
        "provenance": true
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/github": "^12.0.10",
        "@semantic-release/npm": "^13.2.0",
        "@semantic-release/release-notes-generator": "^14.1.1",
        "@types/node": "^26.2.0",
        "conventional-changelog-conventionalcommits": "^9.3.1",
        "eslint": "^10.9.0",
        "eslint-config-prettier": "^10.1.8",
        "homebridge": "^2.4.0",
        "jiti": "^2.7.0",
        "prettier": "^3.9.9",
        "rimraf": "^6.1.3",
        "semantic-release": "^25.0.9",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0",
        "vitest": "^4.1.10"
    }
}
